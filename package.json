{
  "name": "slow-trading-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=3010 PERSISTENT_STORAGE_ROOT=storage/persistent/instances/3010 next dev -p 3010",
    "dev:prod": "PORT=3020 PERSISTENT_STORAGE_ROOT=storage/persistent/instances/3020 next dev -p 3020",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && rm -rf .next/standalone/storage",
    "build:railway": "npm run build && sh scripts/cleanup-railway-runtime.sh",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "start:local": "PORT=3010 PERSISTENT_STORAGE_ROOT=storage/persistent/instances/3010 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "start:prod": "PORT=3020 PERSISTENT_STORAGE_ROOT=storage/persistent/instances/3020 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "monitor:local": "node scripts/monitor-process.mjs --port 3010",
    "monitor:prod": "node scripts/monitor-process.mjs --port 3020",
    "lint": "npx eslint src",
    "dynamic": "npx tsx -r tsconfig-paths/register src/driver/dynamic.ts",
    "exchange": "npx tsx -r tsconfig-paths/register src/driver/exchange.ts",
    "lint:fix": "npx eslint src --fix",
    "type": "npx tsc -p tsconfig.json",
    "test:exchange": "npm run test:integration:exchange",
    "test:exchange:tokocrypto": "vitest run src/__dev__/main/integration/exchange/tokocrypto",
    "test:exchange:binance": "vitest run src/__dev__/main/integration/exchange/binance --passWithNoTests",
    "test:exchange:okx": "vitest run src/__dev__/main/integration/exchange/okx",
    "test:dev": "vitest run src/__dev__/main/integration --exclude 'src/__dev__/main/development/exchange/**' --passWithNoTests",
    "test:prod": "npm run test:quality",
    "test:quality": "vitest run src/__dev__/main/quality",
    "test:integration:exchange": "vitest run src/__dev__/main/integration/exchange",
    "test:playground": "vitest run src/__dev__/main/playground --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:code": "npm run lint && npm run type",
    "logic:full": "npm run test:prod",
    "quality": "npm run test:code && npm run test:quality"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^8.22.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "lightweight-charts": "^5.1.0",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "moment-timezone": "^0.6.0",
    "next": "^16.2.6",
    "notistack": "^3.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.21",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^29.1.1",
    "react-force-graph-3d": "^1.29.1",
    "three-spritetext": "^1.10.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.8"
  }
}
