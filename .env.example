NODE_ENV="development"

# Notification =========================

# Telegram BOT for Trading > @a_bot
TELEGRAM_BOT_TOKEN = 795xxxxx:AAFEQxxxx
TELEGRAM_CHAT_ID = 521xxxx

EMAIL_TO=target@gmail.com
# Optional overrides for the CRM email webhook and authorization token.
N8N_EMAIL_PROXY_URL=https://crm.reinventwp.com/webhook/trading-email-proxy
N8N_EMAIL_PROXY_TOKEN=xx

# Exchange =============================
EXCHANGE=xx

# TOKOCRYPTO
# Tokocrypto > yours@gmail.com
TOKOCRYPTO_1_API_KEY=xx
TOKOCRYPTO_1_API_SECRET=xxx

TOKOCRYPTO_2_API_KEY=xx
TOKOCRYPTO_2_API_SECRET=xxx

# BINANCE
BINANCE_1_API_KEY=xxx
BINANCE_1_API_SECRET=xxx

BINANCE_2_API_KEY=xxx
BINANCE_2_API_SECRET=xxx

# OKX
OKX_1_API_KEY=xx
OKX_1_API_SECRET=xx
OKX_1_API_PASSPHRASE=xx

OKX_2_API_KEY=xx
OKX_2_API_SECRET=xx
OKX_2_API_PASSPHRASE=xx

# Trading ===============================
VOLATILITY_THRESHOLD=5
# Percentage reversal that confirms a pending TOP/BOTTOM vPoint (default: 1).
VOLATILITY_REVERSAL_THRESHOLD=1

## M2 data
FRED_API=xx

# Agent =============================
AGENT_DEFAULT_LOG_CATEGORIES="debug"
PERSISTENT_STORAGE_ROOT="storage/persistent"

# Dashboard PIN protection =============================
# 6-digit numeric PIN for accessing /gainer, /live, and related dashboard APIs.
DASHBOARD_PIN=123456
# Optional extra salt used when hashing auth cookie (recommended to set in production)
DASHBOARD_PIN_SALT="change-me"

APP_NAME=localhost
COIN_METADATA_SYNC_PEERS=https://wealth.reinventwp.com,https://holy.reinventwp.com,https://fast.reinventwp.com

# Runtime memory monitor (MB). Danger must be greater than warning.
MEMORY_MONITOR_WARNING_MB=150
MEMORY_MONITOR_DANGER_MB=430
# Optional comma-separated delivery channels: telegram,email
MEMORY_MONITOR_NOTIFICATION_CHANNELS=telegram,email
# Set to true to disable the production memory monitor.
MEMORY_MONITOR_DISABLED=false
